{
  "expo": {
    "name": "Ascend",
    "slug": "ascend",
    "scheme": "ascend",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maxi1233.ascend",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {}
    },
    "android": {
      "package": "com.maxi1233.ascend",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C5CFF"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Ascend nutzt die Kamera, um QR-Codes von Freunden zu scannen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ascend braucht Zugriff auf deine Fotos, um ein Profilbild auszuw\u00e4hlen.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "owner": "maxi1233",
    "extra": {
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "5d5d1fcc-13bd-46f5-9c98-5753521ce3c6"
      }
    }
  }
}
